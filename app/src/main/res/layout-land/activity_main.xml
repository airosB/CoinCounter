<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 横向き: 左にカウント表示、右にボタン類を並べる -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- 左カラム: カウント表示（縦が狭いので溢れたらスクロールさせる） -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="16dp">

                <TextView
                    android:id="@+id/textViewCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="48sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <!-- コイン種別ごとの入数表示 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="start">

                    <TextView
                        android:id="@+id/textViewCount500"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="500円: 0枚"
                        android:textSize="16sp"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/textViewCount100"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="100円: 0枚"
                        android:textSize="16sp"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/textViewCount50"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="50円: 0枚"
                        android:textSize="16sp"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/textViewCount10"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10円: 0枚"
                        android:textSize="16sp"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/textViewCount5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5円: 0枚"
                        android:textSize="16sp"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/textViewCount1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1円: 0枚"
                        android:textSize="16sp" />

                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- 右カラム: ボタンエリア -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp">

            <!-- 上段ボタン: +1, +5, +10 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/buttonIncrement"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="+1" />

                <Button
                    android:id="@+id/buttonIncrement5"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:text="+5" />

                <Button
                    android:id="@+id/buttonIncrement10"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="+10" />
            </LinearLayout>

            <!-- 下段ボタン: +50, +100, +500 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/buttonIncrement50"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="+50" />

                <Button
                    android:id="@+id/buttonIncrement100"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:text="+100" />

                <Button
                    android:id="@+id/buttonIncrement500"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="+500" />
            </LinearLayout>

            <!-- リセットボタン -->
            <Button
                android:id="@+id/buttonReset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Reset"
                android:backgroundTint="@color/reset_button_background"
                android:textColor="@color/reset_button_text" />

        </LinearLayout>
    </LinearLayout>
</layout>
